{
  "name": "mattermost-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the Mattermost REST API v4 as tools (self-hosted instances).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mattermost-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:integration": "MM_INTEGRATION=1 vitest run src/integration"
  },
  "dependencies": {
    "@mattermost/client": "^11.6",
    "@modelcontextprotocol/sdk": "^1.29",
    "zod": "^3.23",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9",
    "@types/node": "^20.14",
    "eslint": "^9.9",
    "eslint-config-prettier": "^9.1",
    "prettier": "^3.3",
    "tsx": "^4.16",
    "typescript": "^5.5",
    "typescript-eslint": "^8.0",
    "vitest": "^2.0"
  }
}
